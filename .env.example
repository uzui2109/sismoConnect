# Firebase web app configuration.
# These values identify the project and are included in the client bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local Express backend used for chat and social operations.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8085

# Optional: native Google Sign-In. Create an OAuth client in Google Cloud.
# Web Client ID from Google OAuth credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=811581801016-arl6m8lf74edfee6p8j1slvmu61pu5rt.apps.googleusercontent.com

# AdMob. The app ID lives in app.json because the config plugin needs it at
# build time. Leave the rewarded unit empty to use Google's official test ad.
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=

# Optional feature flag. Set to "false" to hide a source without removing code.
EXPO_PUBLIC_NEWS_ENABLED=true

# Push uses direct FCM. It needs google-services.json and a development build;
# see docs/informes-push-moderacion.md before enabling it on a device.
