{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "src/profiles.ts",
    "src/rewards.ts",
    "src/social.ts",
    "src/sources.ts",
    "src/index.ts",
    "src/config.ts",
    "src/notifications.ts",
    "src/moderation.ts",
    "src/chats.ts",
    "functions/src/*"
  ]
}